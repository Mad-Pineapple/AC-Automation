{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack pnpm install",
  "buildCommand": "corepack pnpm run build:vercel",
  "outputDirectory": "artifacts/brand-studio/dist/public",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "node_modules/.pnpm/{pdfjs-dist@,@napi-rs+canvas}*/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/track/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(|index.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "crons": [
    { "path": "/api/cron/dispatch", "schedule": "0 2 * * *" },
    { "path": "/api/cron/frontify-sync", "schedule": "0 3 * * 1" }
  ]
}
