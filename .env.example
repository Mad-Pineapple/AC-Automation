# Copy to .env.local (gitignored) for local dev, or set these in your host's
# environment (Vercel: Settings → Environment Variables). Full reference: README.md.

# --- Required at runtime ---
DATABASE_URL=postgres://localhost:5432/brand_studio
OPENAI_API_KEY=sk-...

# --- Auth (Clerk; omit both to run read-only) ---
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Local dev without Clerk: uncomment to act as an auto-provisioned admin.
# Only honoured when the Clerk keys above are absent. Never set in production.
# DEV_AUTH_BYPASS=1

# --- Frontend build time ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- File storage ---
# Default: local filesystem under OBJECT_STORAGE_DIR.
# OBJECT_STORAGE_DIR=./data/objects
# Setting a Vercel Blob token switches storage to Blob (required on Vercel).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Optional ---
# OPENAI_BASE_URL=
# CRON_SECRET=
# PORT=8080
# LOG_LEVEL=info
